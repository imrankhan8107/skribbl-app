# OCI Authentication
tenancy_ocid         = "ocid1.tenancy.oc1..aaaaaaaaxxx"
user_ocid            = "ocid1.user.oc1..aaaaaaaaxxx"
fingerprint          = "xx:xx:xx:xx:xx:xx:xx:xx"
private_key_path     = "~/.oci/oci_api_key.pem"
# private_key_password = ""  # Optional: only if your private key is passphrase-protected
region               = "us-ashburn-1"
compartment_ocid     = "ocid1.compartment.oc1..aaaaaaaaxxx"
# image_ocid         = ""  # Optional: override auto-discovered Ubuntu 22.04 image OCID

# Base resource name
app_name = "skribbl"

# Networking
vcn_cidr    = "10.10.0.0/16"
subnet_cidr = "10.10.1.0/24"

# ACCESS & SECURITY
# Set true so ANYONE on the internet can play the game at http://<PUBLIC_IP>
# SSH (port 22) still stays locked down to allowed_cidrs for security!
public_access = true

# Whitelist for administrative SSH access (port 22)
# Run 'curl ifconfig.me' to find your public IP
allowed_cidrs = [
  "YOUR_LOCAL_IP/32"
]

# SSH Public Key for OCI instance access
ssh_public_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5..."

# ==============================================================================
# DEPLOYMENT MODE
# ==============================================================================
# Set true for single-machine deployment (OCI Always Free: 1 VM with Docker Compose)
# Set false for multi-host distributed cluster (separate VMs for LB, Gateways, Workers, Redis)
single_instance_mode = true

# --- Single Instance Mode Settings (Always Free Ampere A1.Flex ARM) ---
single_instance_shape         = "VM.Standard.A1.Flex"
single_instance_ocpus         = 4    # Up to 4 free OCPUs
single_instance_memory_in_gbs = 24   # Up to 24 free GB RAM
single_instance_app_scale     = 4    # 4 Python game worker container replicas

# --- Multi-Host Cluster Sizing (Used when single_instance_mode = false) ---
gateway_count     = 2
gateways_per_host = 1
worker_count      = 2
workers_per_host  = 2

lb_shape          = "VM.Standard.E4.Flex"
lb_ocpus          = 2
lb_memory_in_gbs  = 8

gateway_shape         = "VM.Standard.E4.Flex"
gateway_ocpus         = 4
gateway_memory_in_gbs = 16

worker_shape         = "VM.Standard.E4.Flex"
worker_ocpus         = 4
worker_memory_in_gbs = 16

redis_shape         = "VM.Standard.E4.Flex"
redis_ocpus         = 2
redis_memory_in_gbs = 8

enable_load_generator        = true
load_generator_count         = 1
load_generator_shape         = "VM.Standard.E4.Flex"
load_generator_ocpus         = 4
load_generator_memory_in_gbs = 16

# Git repository configuration
git_repo_url = "https://github.com/imrankhan8107/skribbl-app.git"
git_branch   = "feature/go-gateway"

# Performance tuning
trace_enabled           = false
grpc_stream_buffer_size = 1024
grpc_send_queue_maxsize = 1024
