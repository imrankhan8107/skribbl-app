#!/bin/bash
set -ex
exec > /var/log/skribbl-deploy.log 2>&1
echo "=== Skribbl Single-Machine Deployment started at $(date) ==="

# 1. Allow HTTP (80), HTTPS (443), and SSH (22) through local iptables
iptables -I INPUT -p tcp --dport 22 -j ACCEPT || true
iptables -I INPUT -p tcp --dport 80 -j ACCEPT || true
iptables -I INPUT -p tcp --dport 443 -j ACCEPT || true

# 2. OS and TCP stack tuning
sysctl -w fs.file-max=2097152
sysctl -w net.core.somaxconn=65535
sysctl -w net.ipv4.tcp_max_syn_backlog=65535
sysctl -w net.ipv4.ip_local_port_range="1024 65535"
sysctl -w net.ipv4.tcp_tw_reuse=1
echo "fs.file-max=2097152" >> /etc/sysctl.conf
echo "net.core.somaxconn=65535" >> /etc/sysctl.conf
echo "net.ipv4.tcp_max_syn_backlog=65535" >> /etc/sysctl.conf
echo "net.ipv4.ip_local_port_range=1024 65535" >> /etc/sysctl.conf
echo "net.ipv4.tcp_tw_reuse=1" >> /etc/sysctl.conf

echo "* soft nofile 65535" >> /etc/security/limits.conf
echo "* hard nofile 65535" >> /etc/security/limits.conf
echo "root soft nofile 65535" >> /etc/security/limits.conf
echo "root hard nofile 65535" >> /etc/security/limits.conf
echo "ubuntu soft nofile 65535" >> /etc/security/limits.conf
echo "ubuntu hard nofile 65535" >> /etc/security/limits.conf

# 3. Install Docker, Git, and persistence tools
apt-get update -y
apt-get install -y ca-certificates curl gnupg git iptables-persistent

install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
chmod a+r /etc/apt/keyrings/docker.gpg
echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu $(lsb_release -cs) stable" | tee /etc/apt/sources.list.d/docker.list > /dev/null

apt-get update -y
apt-get install -y docker-ce docker-ce-cli containerd.io

systemctl enable docker
systemctl start docker

# 4. Clone repository
cd /home/ubuntu
git clone -b ${git_branch} ${git_repo_url} skribbl-app
cd skribbl-app
chown -R ubuntu:ubuntu /home/ubuntu/skribbl-app

# 5. Save iptables rules
netfilter-persistent save || true

# 6. Build and run single container (FastAPI serving React frontend + WebSocket API directly)
docker build -t skribbl-app .
docker run -d \
  --name skribbl \
  --restart always \
  -p 80:8000 \
  -e PORT=8000 \
  skribbl-app

echo "=== Skribbl Single-Machine Deployment completed at $(date) ==="
