#!/bin/bash
set -euo pipefail

echo "=== Starting Nginx Load Balancer initialization at $(date) ==="

# Apply high-concurrency network tuning
cat <<'EOF' > /etc/sysctl.d/99-nginx-tuning.conf
fs.file-max = 2097152
net.core.somaxconn = 65535
net.ipv4.tcp_max_syn_backlog = 65535
net.core.rmem_max = 16777216
net.core.wmem_max = 16777216
net.ipv4.tcp_rmem = 4096 87380 16777216
net.ipv4.tcp_wmem = 4096 65536 16777216
net.ipv4.tcp_max_tw_buckets = 2000000
net.ipv4.tcp_fin_timeout = 15
net.ipv4.ip_local_port_range = 1024 65535
EOF
sysctl --system

# Configure user file limits
cat <<'EOF' >> /etc/security/limits.conf
* soft nofile 65535
* hard nofile 65535
root soft nofile 65535
root hard nofile 65535
EOF

# Install Nginx
apt-get update -y
apt-get install -y nginx curl git

# Write Nginx configuration with consistent hash upstream
cat <<'EOF' > /etc/nginx/nginx.conf
${nginx_config}
EOF

# Test configuration and start Nginx
nginx -t
systemctl restart nginx
systemctl enable nginx

# Clone repository for monitoring dashboards and cluster monitor scripts
mkdir -p /opt
cd /opt
git clone -b ${git_branch} ${git_repo_url} skribbl-app || true

# Render Prometheus configuration with dynamically discovered Gateway & Worker private IPs
cat <<'EOF' > /opt/skribbl-app/monitoring/prometheus/prometheus.yml
global:
  scrape_interval: 5s
  evaluation_interval: 5s

scrape_configs:
  - job_name: 'gateways'
    metrics_path: '/metrics'
    static_configs:
      - targets:
%{ for ip in gateway_ips ~}
%{ for port in gateway_ports ~}
          - '${ip}:${port}'
%{ endfor ~}
%{ endfor ~}
        labels:
          role: 'gateway'

  - job_name: 'python-workers'
    metrics_path: '/metrics'
    static_configs:
      - targets:
%{ for ip in worker_ips ~}
%{ for port in worker_ports ~}
          - '${ip}:${port}'
%{ endfor ~}
%{ endfor ~}
        labels:
          role: 'worker'

  - job_name: 'cluster-nodes'
    metrics_path: '/metrics'
    static_configs:
      - targets:
%{ for ip in gateway_ips ~}
          - '${ip}:9101'
%{ endfor ~}
%{ for ip in worker_ips ~}
          - '${ip}:9101'
%{ endfor ~}
          - '127.0.0.1:9101'
EOF

%{ if is_primary ~}
# Start Prometheus and Grafana monitoring stack via Docker Compose (primary LB node only)
cd /opt/skribbl-app/monitoring
docker compose up -d
%{ endif ~}

# Start cluster monitor agent on port 9101
if [ -f /opt/skribbl-app/scripts/cluster_monitor.py ]; then
  nohup python3 /opt/skribbl-app/scripts/cluster_monitor.py agent --role "lb-${lb_id}" --port 9101 > /var/log/skribbl-monitor.log 2>&1 &
fi

echo "=== Load Balancer initialization finished at $(date) ==="
