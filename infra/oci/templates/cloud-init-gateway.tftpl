#!/bin/bash
set -euo pipefail

echo "=== Starting Go Gateway initialization at $(date) ==="

# Apply kernel and TCP performance tuning for high-concurrency WebSocket connections
cat <<'EOF' > /etc/sysctl.d/99-websocket-tuning.conf
fs.file-max = 2097152
net.core.somaxconn = 65535
net.ipv4.tcp_max_syn_backlog = 65535
net.core.rmem_max = 16777216
net.core.wmem_max = 16777216
net.ipv4.tcp_rmem = 4096 87380 16777216
net.ipv4.tcp_wmem = 4096 65536 16777216
net.ipv4.tcp_max_tw_buckets = 2000000
net.ipv4.tcp_fin_timeout = 15
net.ipv4.ip_local_port_range = 1024 65535
EOF
sysctl --system

# Configure user file limits
cat <<'EOF' >> /etc/security/limits.conf
* soft nofile 65535
* hard nofile 65535
root soft nofile 65535
root hard nofile 65535
EOF

# Clone repository
mkdir -p /opt
cd /opt
git clone -b ${git_branch} ${git_repo_url} skribbl-app
cd skribbl-app

# Retrieve instance private IP via OCI metadata service
PRIVATE_IP=$(curl -s -m 10 http://169.254.169.254/opc/v2/vnics/ | grep -oP '"privateIp":\s*"\K[^"]+' | head -n 1 || hostname -I | awk '{print $1}')

# Build Gateway Docker image
docker build -t skribbl-gateway -f gateway/Dockerfile .

mkdir -p /var/log/skribbl

# Start Go Gateway Docker containers with host networking
for i in $(seq 1 ${gateways_per_host}); do
  OFFSET=$(( (i - 1) * 2 ))
  DATA_PORT=$(( 9000 + OFFSET ))
  COORD_PORT=$(( 9100 + OFFSET ))
  GW_ID="${gateway_id}-$i"
  echo "Launching Gateway container $GW_ID on data:$DATA_PORT, coord:$COORD_PORT..."
  docker run -d \
    --name "gateway-$i" \
    --restart always \
    --net host \
    --ulimit nofile=65535:65535 \
    -e GATEWAY_ID=$GW_ID \
    -e GATEWAY_ADDR=$PRIVATE_IP \
    -e SEND_BUFFER=1024 \
    -e TRACE_ENABLED=${trace_enabled} \
    -e GRPC_STREAM_BUFFER_SIZE=${grpc_stream_buffer_size} \
    -e WRITE_COALESCE=${write_coalesce} \
    skribbl-gateway \
    -port $DATA_PORT \
    -coord-port $COORD_PORT \
    -redis redis://${redis_ip}:6379 \
    -static /static

  # Stream filtered logs to a file in the background (only keeping errors/warnings to save space)
  docker logs -f "gateway-$i" 2>&1 | grep --line-buffered -iE "error|timeout|blocked|missed|fail|warn|exception" > /var/log/skribbl/gateway-$i.log &
done

# Start a simple HTTP server to serve the logs directory on port 8080
nohup python3 -m http.server 8080 --directory /var/log/skribbl > /dev/null 2>&1 &

# Start cluster performance and network traffic monitor on port 9101
nohup python3 /opt/skribbl-app/scripts/cluster_monitor.py agent --role "gateway" --port 9101 > /var/log/skribbl-monitor.log 2>&1 &

echo "=== Gateway initialization finished at $(date) ==="
