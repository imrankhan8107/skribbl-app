# AWS Region
aws_region = "us-east-1"

# Resource naming prefix
app_name = "skribbl"

# Your public IP address/CIDR for strict ingress (e.g. "203.0.113.45/32")
# Find your IP via: curl ifconfig.me
# ZERO ports will be open to 0.0.0.0/0
allowed_cidr = "YOUR_PUBLIC_IP/32"

# Path or content of SSH public key for EC2 instance access
# e.g. "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5..."
ssh_public_key = "ssh-ed25519 AAAA..."

# Scale presets:
# Dev / baseline: gateway_count=2, gateways_per_host=1, worker_count=2, workers_per_host=2 (t3.medium)
# 25k load:       gateway_count=3, gateways_per_host=2 (6 gw), worker_count=4, workers_per_host=6 (24 workers, c5a.2xlarge)
# 50k load:       gateway_count=3, gateways_per_host=3 (9 gw), worker_count=5, workers_per_host=6 (30 workers, c5a.2xlarge)
# 75k load:       gateway_count=4, gateways_per_host=3 (12 gw), worker_count=5, workers_per_host=6 (30 workers, c5a.2xlarge)
gateway_count     = 3
gateways_per_host = 3
worker_count      = 5
workers_per_host  = 6

# Instance types:
# For <=15k: t3.medium / c5a.xlarge
# For 35k-50k: c5a.2xlarge for gateways and workers, c5a.xlarge for LB, c5a.large for Redis
# For 75k+:    c5a.2xlarge for LB, gateways, and workers
lb_instance_type      = "c5a.xlarge"
gateway_instance_type = "c5a.2xlarge"
worker_instance_type  = "c5a.2xlarge"
redis_instance_type   = "c5a.large"

# Git repository configuration
git_repo_url = "https://github.com/imrankhan8107/skribbl-app.git"
git_branch   = "hotfix/scale-and-fanout-remediation"

# In-VPC k6 load generator instances
# For <=50k: load_generator_count=1, load_generator_instance_type="c5a.8xlarge"
# For 75k+:  load_generator_count=2 (distributes client event loops across 2 machines to avoid 100% runner CPU)
enable_load_generator        = true
load_generator_count         = 1
load_generator_instance_type = "c5a.8xlarge"

# Verbose per-message tracing (true for dev/small runs, false for 15k+ benchmarks to avoid logger mutex contention)
trace_enabled = false

# Worker outbound gRPC stream buffer capacity per room (prevents memory explosion during high-rate stroke fan-out)
grpc_send_queue_maxsize = 1024

# Go Gateway outbound gRPC stream buffer capacity per worker stream (prevents room creation drops at 100k scale)
grpc_stream_buffer_size = 4096



