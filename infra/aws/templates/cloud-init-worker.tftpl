#!/bin/bash
set -ex
exec > /var/log/skribbl-worker-init.log 2>&1
echo "=== Worker initialization started at $(date) ==="

# OS tuning
sysctl -w net.core.somaxconn=65535
echo "net.core.somaxconn=65535" >> /etc/sysctl.conf
echo "* soft nofile 65535" >> /etc/security/limits.conf
echo "* hard nofile 65535" >> /etc/security/limits.conf

# Install Docker and Git
apt-get update -y
apt-get install -y ca-certificates curl gnupg git

install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
chmod a+r /etc/apt/keyrings/docker.gpg
echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu $(lsb_release -cs) stable" | tee /etc/apt/sources.list.d/docker.list > /dev/null

apt-get update -y
apt-get install -y docker-ce docker-ce-cli containerd.io

systemctl enable docker
systemctl start docker

# Clone repository
cd /opt
git clone -b ${git_branch} ${git_repo_url} skribbl-app
cd skribbl-app

# Retrieve instance private IP via IMDSv2
TOKEN=$(curl -s -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 21600")
PRIVATE_IP=$(curl -s -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/local-ipv4)

# Build worker image
docker build -t skribbl-worker .

# Run worker container using host networking for low latency
docker run -d \
  --name worker \
  --restart always \
  --net host \
  --ulimit nofile=65535:65535 \
  -e REDIS_URL=redis://${redis_ip}:6379 \
  -e GRPC_ENABLED=true \
  -e GRPC_PORT=50051 \
  -e WORKER_ADVERTISE_HOST=$PRIVATE_IP \
  skribbl-worker

echo "=== Worker initialization finished at $(date) ==="

