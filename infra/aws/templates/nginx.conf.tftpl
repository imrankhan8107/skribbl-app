worker_processes auto;
worker_rlimit_nofile 262144;

events {
    worker_connections 131072;
}

http {
    # Room-sticky consistent hashing load balancing across AWS Go Gateways
    upstream gateways {
        hash "$arg_gw$arg_room$arg_cid" consistent;
%{ for ip in gateway_ips ~}
%{ for port in gateway_ports ~}
        server ${ip}:${port};
%{ endfor ~}
%{ endfor ~}
    }

    # Coord upstream: plain round-robin across all gateway coord ports.
    # Redis-backed so any container can serve any room — no stickiness needed.
    # keepalive reuses connections to gateways so each k6 poll doesn't create a
    # new TCP handshake, eliminating the accept-queue pressure that caused ~18-20%
    # coord failures under 25k VUs.
    upstream coord {
        least_conn;
%{ for ip in gateway_ips ~}
%{ for port in coord_ports ~}
        server ${ip}:${port};
%{ endfor ~}
%{ endfor ~}
        keepalive 256;
    }

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    server {
        listen 80;

        # Coord REST endpoint — routed to coord upstream (bypasses WS stickiness)
        location /rooms/ {
            proxy_pass http://coord;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_connect_timeout 5s;
            proxy_read_timeout 10s;
            proxy_send_timeout 5s;
        }

        location / {
            proxy_pass http://gateways;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            # WebSocket support
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;

            # WebSocket timeouts
            proxy_read_timeout 86400s;
            proxy_send_timeout 86400s;
        }
    }
}

