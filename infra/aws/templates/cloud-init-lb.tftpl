#!/bin/bash
set -ex
exec > /var/log/skribbl-lb-init.log 2>&1
echo "=== Load Balancer initialization started at $(date) ==="

# OS and TCP stack tuning for high-concurrency WebSocket load
sysctl -w fs.file-max=2097152
sysctl -w net.core.somaxconn=65535
sysctl -w net.ipv4.tcp_max_syn_backlog=65535
sysctl -w net.ipv4.ip_local_port_range="1024 65535"
sysctl -w net.ipv4.tcp_tw_reuse=1
echo "fs.file-max=2097152" >> /etc/sysctl.conf
echo "net.core.somaxconn=65535" >> /etc/sysctl.conf
echo "net.ipv4.tcp_max_syn_backlog=65535" >> /etc/sysctl.conf
echo "net.ipv4.ip_local_port_range=1024 65535" >> /etc/sysctl.conf
echo "net.ipv4.tcp_tw_reuse=1" >> /etc/sysctl.conf

echo "* soft nofile 262144" >> /etc/security/limits.conf
echo "* hard nofile 262144" >> /etc/security/limits.conf
echo "root soft nofile 262144" >> /etc/security/limits.conf
echo "root hard nofile 262144" >> /etc/security/limits.conf

# Install Nginx, Git, Python3, and Docker
apt-get update -y
apt-get install -y ca-certificates curl gnupg nginx git python3

install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
chmod a+r /etc/apt/keyrings/docker.gpg
echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu $(lsb_release -cs) stable" | tee /etc/apt/sources.list.d/docker.list > /dev/null

apt-get update -y
apt-get install -y docker-ce docker-ce-cli containerd.io docker-compose-plugin

systemctl enable docker
systemctl start docker

# Write rendered Nginx configuration
cat <<'EOF' > /etc/nginx/nginx.conf
${nginx_config}
EOF

# Ensure systemd allows Nginx high file descriptor limits
mkdir -p /etc/systemd/system/nginx.service.d/
cat <<'EOF' > /etc/systemd/system/nginx.service.d/limits.conf
[Service]
LimitNOFILE=262144
EOF

systemctl daemon-reload
nginx -t
systemctl enable nginx
systemctl restart nginx

# Clone repository for monitoring agent and Prometheus/Grafana stack
mkdir -p /opt
cd /opt
git clone -b ${git_branch} ${git_repo_url} skribbl-app || true

# Render Prometheus configuration with dynamically discovered AWS Gateway & Worker private IPs
cat <<'EOF' > /opt/skribbl-app/monitoring/prometheus/prometheus.yml
global:
  scrape_interval: 5s
  evaluation_interval: 5s

scrape_configs:
  - job_name: 'go-gateways'
    metrics_path: '/metrics'
    static_configs:
      - targets:
%{ for ip in gateway_ips ~}
%{ for port in gateway_ports ~}
          - '${ip}:${port}'
%{ endfor ~}
%{ endfor ~}
        labels:
          role: 'gateway'

  - job_name: 'python-workers'
    metrics_path: '/metrics'
    static_configs:
      - targets:
%{ for ip in worker_ips ~}
%{ for port in worker_ports ~}
          - '${ip}:${port}'
%{ endfor ~}
%{ endfor ~}
        labels:
          role: 'worker'
EOF

# Start Prometheus and Grafana monitoring stack via Docker Compose
cd /opt/skribbl-app/monitoring
docker compose up -d

# Start cluster monitor agent on port 9101
if [ -f /opt/skribbl-app/scripts/cluster_monitor.py ]; then
  nohup python3 /opt/skribbl-app/scripts/cluster_monitor.py agent --role "lb" --port 9101 > /var/log/skribbl-monitor.log 2>&1 &
fi

echo "=== Load Balancer initialization finished at $(date) ==="
