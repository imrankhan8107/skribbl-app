#!/bin/bash
set -euo pipefail

echo "=== Starting Load Generator initialization at $(date) ==="

# 1. Apply kernel TCP & socket tuning
cat <<'EOF' > /etc/sysctl.d/99-k6-tuning.conf
fs.file-max = 2097152
net.core.somaxconn = 65535
net.ipv4.tcp_max_syn_backlog = 65535
net.core.rmem_max = 16777216
net.core.wmem_max = 16777216
net.ipv4.tcp_rmem = 4096 87380 16777216
net.ipv4.tcp_wmem = 4096 65536 16777216
net.ipv4.tcp_max_tw_buckets = 2000000
net.ipv4.tcp_fin_timeout = 15
net.ipv4.ip_local_port_range = 1024 65535
EOF
sysctl --system

# Configure user file limits
cat <<'EOF' >> /etc/security/limits.conf
* soft nofile 131072
* hard nofile 131072
root soft nofile 131072
root hard nofile 131072
ubuntu soft nofile 131072
ubuntu hard nofile 131072
EOF

# 1.5 Configure Swap Space (24 GB) to prevent k6 OOM kill on high VU tests
if [ ! -f /swapfile ]; then
  fallocate -l 24G /swapfile || dd if=/dev/zero of=/swapfile bs=1M count=24576
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi

# 2. Install Git, Python3, and k6
apt-get update -y
apt-get install -y ca-certificates curl gnupg git htop python3 golang-go

curl -fsSL https://dl.k6.io/key.gpg | gpg --dearmor --yes -o /usr/share/keyrings/k6-archive-keyring.gpg
echo "deb [signed-by=/usr/share/keyrings/k6-archive-keyring.gpg] https://dl.k6.io/deb stable main" | tee /etc/apt/sources.list.d/k6.list
apt-get update -y
apt-get install -y k6

# 3. Clone repository into ubuntu home
su - ubuntu -c "git clone -b ${git_branch} ${git_repo_url} /home/ubuntu/skribbl-app"

# 4. Generate /home/ubuntu/run-test.sh
cat << 'EOF' > /home/ubuntu/run-test.sh
#!/bin/bash
# Usage: ./run-test.sh [VUS] [PLAYERS_PER_ROOM] [STROKE_HZ] [RAMP_SECONDS] [HOLD_SECONDS] [VU_OFFSET]
VUS=$${1:-100}
PLAYERS=$${2:-2}
HZ=$${3:-20}
RAMP=$${4:-0}
HOLD=$${5:-$${HOLD_SECONDS:-2400}}

# Runner identity & automated VU_OFFSET calculation
RUNNER_ID=${runner_id}
DEFAULT_OFFSET=$(( (RUNNER_ID - 1) * VUS ))
VU_OFFSET=$${6:-$${VU_OFFSET:-$DEFAULT_OFFSET}}

COORD_HOST="${coord_host}"
COORD_HOSTS="${coord_hosts}"
COORD_URLS="${coord_urls}"
COORD_PORT=9100
HEALTH_URLS="${gateway_health_urls}"
CLUSTER_NODES="${cluster_nodes},load-gen-${runner_id}:127.0.0.1:9101"

echo "=========================================================="
echo " Starting Skribbl In-VNet k6 Load Test (Runner $RUNNER_ID/${runner_count})"
echo " Target LBs: ${lb_target_hosts} (Primary: ${lb_target_host}:80)"
echo " Coord URLs: $COORD_URLS"
echo " Gateway health targets: $HEALTH_URLS"
echo " VUs: $VUS (VU_OFFSET: $VU_OFFSET) | Players/Room: $PLAYERS | Stroke: $${HZ}Hz | Ramp: $${RAMP}s | Hold: $${HOLD}s"
echo "=========================================================="

echo ""
echo "=== Resetting measurement window across all cluster instances ==="
python3 /home/ubuntu/skribbl-app/scripts/cluster_monitor.py reset --nodes "$CLUSTER_NODES" || true
echo ""

ulimit -n 131072 2>/dev/null || ulimit -n "$(ulimit -Hn)" 2>/dev/null || true
echo "k6 process file-descriptor limit (ulimit -n): $(ulimit -n)"

cd /home/ubuntu/skribbl-app
k6 run \
  -e HOSTS="${lb_target_hosts}" \
  -e HOST=${lb_target_host} \
  -e PORT=80 \
  -e COORD_HOST=$COORD_HOST \
  -e COORD_HOSTS="$COORD_HOSTS" \
  -e COORD_URLS="$COORD_URLS" \
  -e COORD_PORT=$COORD_PORT \
  -e HEALTH_URLS="$HEALTH_URLS" \
  -e TURN_DURATION=30 \
  -e VUS=$VUS \
  -e VU_OFFSET=$VU_OFFSET \
  -e PLAYERS_PER_ROOM=$PLAYERS \
  -e STROKE_HZ=$HZ \
  -e RAMP_SECONDS=$RAMP \
  -e HOLD_SECONDS=$HOLD \
  -e CONNECT_TIMEOUT_MS=$${CONNECT_TIMEOUT_MS:-60000} \
  scripts/k6_grpc_load_test.js

echo ""
echo "=== Fetching Cluster Performance & Network Traffic Report ==="
python3 /home/ubuntu/skribbl-app/scripts/cluster_monitor.py report --nodes "$CLUSTER_NODES" --output /home/ubuntu/k6-cluster-metrics.json
EOF

chmod +x /home/ubuntu/run-test.sh
chown ubuntu:ubuntu /home/ubuntu/run-test.sh

# ------------------------------------------------------------------------------
# Generate /home/ubuntu/run-test-2.sh (Go Load Tester)
# ------------------------------------------------------------------------------
cat << 'EOF' > /home/ubuntu/run-test-2.sh
#!/bin/bash
VUS=$${1:-100}
PLAYERS=$${2:-2}
HZ=$${3:-20}
RAMP=$${4:-0}
HOLD=$${5:-$${HOLD_SECONDS:-2400}}

RUNNER_ID=${runner_id}
DEFAULT_OFFSET=$(( (RUNNER_ID - 1) * VUS ))
VU_OFFSET=$${6:-$${VU_OFFSET:-$DEFAULT_OFFSET}}

export HOSTS="${lb_target_hosts}"
export HOST=${lb_target_host}
export PORT=80
export COORD_HOST="${coord_host}"
export COORD_HOSTS="${coord_hosts}"
export COORD_URLS="${coord_urls}"
export COORD_PORT=9100
export HEALTH_URLS="${gateway_health_urls}"
CLUSTER_NODES="${cluster_nodes},load-gen-${runner_id}:127.0.0.1:9101"

echo "=========================================================="
echo " Starting Skribbl In-VNet Go Load Test (Runner $RUNNER_ID/${runner_count})"
echo " Target LBs: ${lb_target_hosts} (Primary: ${lb_target_host}:80)"
echo " Coord URLs: $COORD_URLS"
echo " Gateway health targets: $HEALTH_URLS"
echo " VUs: $VUS (VU_OFFSET: $VU_OFFSET) | Players/Room: $PLAYERS | Stroke: $${HZ}Hz | Ramp: $${RAMP}s | Hold: $${HOLD}s"
echo "=========================================================="

echo ""
echo "=== Resetting measurement window across all cluster instances ==="
python3 /home/ubuntu/skribbl-app/scripts/cluster_monitor.py reset --nodes "$CLUSTER_NODES" || true
echo ""

ulimit -n 131072 2>/dev/null || ulimit -n "$(ulimit -Hn)" 2>/dev/null || true

cd /home/ubuntu/skribbl-app
if [ ! -f ./loadtest-bin ] || [ ./loadtest/main.go -nt ./loadtest-bin ]; then
  (cd loadtest && go build -o ../loadtest-bin .)
fi

./loadtest-bin \
  -vus $VUS \
  -players $PLAYERS \
  -hz $HZ \
  -ramp $RAMP \
  -hold $HOLD \
  -offset $VU_OFFSET

echo ""
echo "=== Fetching Cluster Performance & Network Traffic Report ==="
python3 /home/ubuntu/skribbl-app/scripts/cluster_monitor.py report --nodes "$CLUSTER_NODES" --output /home/ubuntu/go-cluster-metrics.json
EOF

chmod +x /home/ubuntu/run-test-2.sh
chown ubuntu:ubuntu /home/ubuntu/run-test-2.sh

# Pre-compile the Go load tester binary (safe fallback if already built)
(cd /home/ubuntu/skribbl-app/loadtest && go build -o /home/ubuntu/skribbl-app/loadtest-bin .) || true

echo "=== Load Generator initialization finished at $(date) ==="
