                  <!-- Draw strokes until turn ends -->
                  <WhileController guiclass="WhileControllerGui" testclass="WhileController" testname="Draw Loop" enabled="true">
                    <stringProp name="WhileController.condition">${__groovy(vars.get("joiner_turn_ended") != "true")}</stringProp>
                  </WhileController>
                  <hashTree>
                    <eu.luminis.jmeter.wssampler.SingleWriteWebSocketSampler guiclass="eu.luminis.jmeter.wssampler.SingleWriteWebSocketSamplerGui" testclass="eu.luminis.jmeter.wssampler.SingleWriteWebSocketSampler" testname="WS Send - stroke (Joiner-Drawer)" enabled="true">
                      <boolProp name="createNewConnection">false</boolProp>
                      <stringProp name="requestData">{"type":"stroke","payload":{"points":[[${__Random(0,800)},${__Random(0,600)}],[${__Random(0,800)},${__Random(0,600)}]],"color":"#${__RandomString(6,0123456789abcdef)}","size":${__Random(2,8)}}}</stringProp>
                      <stringProp name="dataType">Text</stringProp>
                    </eu.luminis.jmeter.wssampler.SingleWriteWebSocketSampler>
                    <hashTree/>
                    <eu.luminis.jmeter.wssampler.SingleReadWebSocketSampler guiclass="eu.luminis.jmeter.wssampler.SingleReadWebSocketSamplerGui" testclass="eu.luminis.jmeter.wssampler.SingleReadWebSocketSampler" testname="WS Read - events (drawer)" enabled="true">
                      <boolProp name="createNewConnection">false</boolProp>
                      <stringProp name="dataType">Text</stringProp>
                      <stringProp name="readTimeout">3000</stringProp>
                    </eu.luminis.jmeter.wssampler.SingleReadWebSocketSampler>
                    <hashTree>
                      <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Check turn_ended" enabled="true">
                        <stringProp name="scriptLanguage">groovy</stringProp>
                        <stringProp name="script">
def response = prev.getResponseDataAsString()
if (response?.contains("turn_ended") || response?.contains("game_over")) {
    vars.put("joiner_turn_ended", "true")
    if (response?.contains("game_over")) vars.put("joiner_game_over", "true")
}
                        </stringProp>
                      </JSR223PostProcessor>
                      <hashTree/>
                    </hashTree>
                    <UniformRandomTimer guiclass="UniformRandomTimerGui" testclass="UniformRandomTimer" testname="Draw Pace (50-150ms)" enabled="true">
                      <stringProp name="ConstantTimer.delay">50</stringProp>
                      <stringProp name="RandomTimer.range">100</stringProp>
                    </UniformRandomTimer>
                    <hashTree/>
                  </hashTree>

                </hashTree>
                <!-- End If I Am Drawer -->

                <!-- BRANCH B: I am a guesser this turn -->
                <IfController guiclass="IfControllerPanel" testclass="IfController" testname="If I Am Guesser" enabled="true">
                  <stringProp name="IfController.condition">${__groovy(vars.get("joiner_word_choice") == "NONE" || vars.get("joiner_turn_msg") == "turn_started")}</stringProp>
                  <boolProp name="IfController.evaluateAll">false</boolProp>
                  <boolProp name="IfController.useExpression">true</boolProp>
                </IfController>
                <hashTree>

                  <!-- If we haven't yet received turn_started, wait for it -->
                  <IfController guiclass="IfControllerPanel" testclass="IfController" testname="If Need turn_started" enabled="true">
                    <stringProp name="IfController.condition">${__groovy(vars.get("joiner_turn_msg") != "turn_started")}</stringProp>
                    <boolProp name="IfController.evaluateAll">false</boolProp>
                    <boolProp name="IfController.useExpression">true</boolProp>
                  </IfController>
                  <hashTree>
                    <eu.luminis.jmeter.wssampler.SingleReadWebSocketSampler guiclass="eu.luminis.jmeter.wssampler.SingleReadWebSocketSamplerGui" testclass="eu.luminis.jmeter.wssampler.SingleReadWebSocketSampler" testname="WS Read - turn_started (guesser)" enabled="true">
                      <boolProp name="createNewConnection">false</boolProp>
                      <stringProp name="dataType">Text</stringProp>
                      <stringProp name="readTimeout">${GAME_READ_TIMEOUT}</stringProp>
                    </eu.luminis.jmeter.wssampler.SingleReadWebSocketSampler>
                    <hashTree/>
                  </hashTree>

                  <!-- Read clear_canvas -->
                  <eu.luminis.jmeter.wssampler.SingleReadWebSocketSampler guiclass="eu.luminis.jmeter.wssampler.SingleReadWebSocketSamplerGui" testclass="eu.luminis.jmeter.wssampler.SingleReadWebSocketSampler" testname="WS Read - clear_canvas (guesser)" enabled="true">
                    <boolProp name="createNewConnection">false</boolProp>
                    <stringProp name="dataType">Text</stringProp>
                    <stringProp name="readTimeout">5000</stringProp>
                  </eu.luminis.jmeter.wssampler.SingleReadWebSocketSampler>
                  <hashTree/>

                  <!-- Guess loop -->
                  <WhileController guiclass="WhileControllerGui" testclass="WhileController" testname="Guess Loop" enabled="true">
                    <stringProp name="WhileController.condition">${__groovy(vars.get("joiner_turn_ended") != "true")}</stringProp>
                  </WhileController>
                  <hashTree>
                    <eu.luminis.jmeter.wssampler.SingleWriteWebSocketSampler guiclass="eu.luminis.jmeter.wssampler.SingleWriteWebSocketSamplerGui" testclass="eu.luminis.jmeter.wssampler.SingleWriteWebSocketSampler" testname="WS Send - guess" enabled="true">
                      <boolProp name="createNewConnection">false</boolProp>
                      <stringProp name="requestData">{"type":"guess","payload":{"text":"${__RandomString(${__Random(3,8)},abcdefghijklmnopqrstuvwxyz)}"}}</stringProp>
                      <stringProp name="dataType">Text</stringProp>
                    </eu.luminis.jmeter.wssampler.SingleWriteWebSocketSampler>
                    <hashTree/>
                    <eu.luminis.jmeter.wssampler.SingleReadWebSocketSampler guiclass="eu.luminis.jmeter.wssampler.SingleReadWebSocketSamplerGui" testclass="eu.luminis.jmeter.wssampler.SingleReadWebSocketSampler" testname="WS Read - events (guesser)" enabled="true">
                      <boolProp name="createNewConnection">false</boolProp>
                      <stringProp name="dataType">Text</stringProp>
                      <stringProp name="readTimeout">5000</stringProp>
                    </eu.luminis.jmeter.wssampler.SingleReadWebSocketSampler>
                    <hashTree>
                      <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Check turn_ended (guesser)" enabled="true">
                        <stringProp name="scriptLanguage">groovy</stringProp>
                        <stringProp name="script">
def response = prev.getResponseDataAsString()
if (response?.contains("turn_ended") || response?.contains("game_over")) {
    vars.put("joiner_turn_ended", "true")
    if (response?.contains("game_over")) vars.put("joiner_game_over", "true")
}
                        </stringProp>
                      </JSR223PostProcessor>
                      <hashTree/>
                    </hashTree>
                    <UniformRandomTimer guiclass="UniformRandomTimerGui" testclass="UniformRandomTimer" testname="Guess Pace (2-4s)" enabled="true">
                      <stringProp name="ConstantTimer.delay">2000</stringProp>
                      <stringProp name="RandomTimer.range">2000</stringProp>
                    </UniformRandomTimer>
                    <hashTree/>
                  </hashTree>

                </hashTree>
                <!-- End If I Am Guesser -->

                <!-- Reset per-turn flags -->
                <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Reset Turn Flags" enabled="true">
                  <stringProp name="scriptLanguage">groovy</stringProp>
                  <stringProp name="script">
vars.put("joiner_turn_ended", "false")
vars.put("joiner_word_choice", "NONE")
vars.put("joiner_turn_msg", "unknown")
                  </stringProp>
                </JSR223Sampler>
                <hashTree/>

              </hashTree>
              <!-- End TC Joiner Play Turn -->

            </hashTree>
            <!-- End Turn Loop -->

            <!-- ===== Phase 4: Game Over ===== -->
            <IfController guiclass="IfControllerPanel" testclass="IfController" testname="If game_over not yet received" enabled="true">
              <stringProp name="IfController.condition">${__groovy(vars.get("joiner_game_over") != "true")}</stringProp>
              <boolProp name="IfController.evaluateAll">false</boolProp>
              <boolProp name="IfController.useExpression">true</boolProp>
            </IfController>
            <hashTree>
              <eu.luminis.jmeter.wssampler.SingleReadWebSocketSampler guiclass="eu.luminis.jmeter.wssampler.SingleReadWebSocketSamplerGui" testclass="eu.luminis.jmeter.wssampler.SingleReadWebSocketSampler" testname="WS Read - game_over (Joiner)" enabled="true">
                <boolProp name="createNewConnection">false</boolProp>
                <stringProp name="dataType">Text</stringProp>
                <stringProp name="readTimeout">${GAME_READ_TIMEOUT}</stringProp>
              </eu.luminis.jmeter.wssampler.SingleReadWebSocketSampler>
              <hashTree>
                <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert game_over" enabled="true">
                  <collectionProp name="Asserion.test_strings">
                    <stringProp name="0">game_over</stringProp>
                  </collectionProp>
                  <stringProp name="Assertion.test_field">Assertion.response_data</stringProp>
                  <intProp name="Assertion.test_type">2</intProp>
                </ResponseAssertion>
                <hashTree/>
              </hashTree>
            </hashTree>

            <!-- ===== Phase 5: Receive rematch_started (host sends rematch) ===== -->
            <eu.luminis.jmeter.wssampler.SingleReadWebSocketSampler guiclass="eu.luminis.jmeter.wssampler.SingleReadWebSocketSamplerGui" testclass="eu.luminis.jmeter.wssampler.SingleReadWebSocketSampler" testname="WS Read - rematch_started (Joiner)" enabled="true">
              <boolProp name="createNewConnection">false</boolProp>
              <stringProp name="dataType">Text</stringProp>
              <stringProp name="readTimeout">${GAME_READ_TIMEOUT}</stringProp>
            </eu.luminis.jmeter.wssampler.SingleReadWebSocketSampler>
            <hashTree>
              <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert rematch_started (Joiner)" enabled="true">
                <collectionProp name="Asserion.test_strings">
                  <stringProp name="0">rematch_started</stringProp>
                </collectionProp>
                <stringProp name="Assertion.test_field">Assertion.response_data</stringProp>
                <intProp name="Assertion.test_type">2</intProp>
              </ResponseAssertion>
              <hashTree/>
            </hashTree>

          </hashTree>
          <!-- End If Join Succeeded -->

          <!-- Close connection -->
          <eu.luminis.jmeter.wssampler.SingleWriteWebSocketSampler guiclass="eu.luminis.jmeter.wssampler.SingleWriteWebSocketSamplerGui" testclass="eu.luminis.jmeter.wssampler.SingleWriteWebSocketSampler" testname="WS Send - leave_room (Joiner)" enabled="true">
            <boolProp name="createNewConnection">false</boolProp>
            <stringProp name="requestData">{"type":"leave_room","payload":{}}</stringProp>
            <stringProp name="dataType">Text</stringProp>
          </eu.luminis.jmeter.wssampler.SingleWriteWebSocketSampler>
          <hashTree/>

          <eu.luminis.jmeter.wssampler.CloseWebSocketSampler guiclass="eu.luminis.jmeter.wssampler.CloseWebSocketSamplerGui" testclass="eu.luminis.jmeter.wssampler.CloseWebSocketSampler" testname="WS Close (Joiner)" enabled="true">
            <stringProp name="statusCode">1000</stringProp>
            <stringProp name="readTimeout">3000</stringProp>
          </eu.luminis.jmeter.wssampler.CloseWebSocketSampler>
          <hashTree/>

        </hashTree>
        <!-- End If Room Available -->

      </hashTree>

      <!-- ================================================================ -->
      <!-- TEARDOWN: Clean shared properties                                -->
      <!-- ================================================================ -->
      <PostThreadGroup guiclass="PostThreadGroupGui" testclass="PostThreadGroup" testname="tearDown - Cleanup Properties" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">1</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">1</stringProp>
        <stringProp name="ThreadGroup.ramp_time">1</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
      </PostThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Cleanup E2E Properties" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">
// Print error classification summary
def total = (props.get("TOTAL_SAMPLES") ?: "0").toInteger()
def infraErrors = (props.get("INFRA_ERRORS") ?: "0").toInteger()
def assertionMismatches = (props.get("ASSERTION_MISMATCHES") ?: "0").toInteger()
def samplerErrors = (props.get("SAMPLER_ERRORS") ?: "0").toInteger()
def appErrors = (props.get("APP_ERRORS") ?: "0").toInteger()
def realErrors = infraErrors + appErrors

log.info("=" * 60)
log.info("  PERFORMANCE TEST - ERROR CLASSIFICATION SUMMARY")
log.info("=" * 60)
log.info("  Total Samples:           ${total}")
log.info("  Infrastructure Errors:   ${infraErrors} (${total > 0 ? (infraErrors*100.0/total).round(2) : 0}%)")
log.info("  Application Errors:      ${appErrors} (${total > 0 ? (appErrors*100.0/total).round(2) : 0}%)")
log.info("  Sampler/Config Errors:   ${samplerErrors}")
log.info("  Assertion Mismatches:    ${assertionMismatches} (not real errors)")
log.info("-" * 60)
log.info("  REAL Error Rate:         ${total > 0 ? (realErrors*100.0/total).round(2) : 0}% (infra + app)")
log.info("  Reported Error Rate:     ${total > 0 ? ((infraErrors+appErrors+assertionMismatches+samplerErrors)*100.0/total).round(2) : 0}% (includes assertion mismatches)")
log.info("=" * 60)

// Clean up all E2E properties
props.remove("E2E_ROOM_CODES")
props.remove("TOTAL_SAMPLES")
props.remove("INFRA_ERRORS")
props.remove("ASSERTION_MISMATCHES")
props.remove("SAMPLER_ERRORS")
props.remove("APP_ERRORS")
def sessions = (vars.get("GAME_SESSIONS") ?: "5").toInteger()
for (int i = 0; i &lt; sessions; i++) {
    props.remove("E2E_ROOM_${i}")
}
log.info("Teardown: All properties cleaned")
          </stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>

      <!-- ================================================================ -->
      <!-- ERROR CLASSIFICATION & AUTO-STOP                                 -->
      <!-- Tracks real errors vs assertion mismatches separately.           -->
      <!-- Stops the test if infrastructure error rate exceeds threshold.   -->
      <!-- ================================================================ -->

      <!-- Global JSR223 Listener: Classify errors and track metrics -->
      <JSR223Listener guiclass="TestBeanGUI" testclass="JSR223Listener" testname="Error Classifier &amp; Metrics Tracker" enabled="true">
        <stringProp name="scriptLanguage">groovy</stringProp>
        <stringProp name="script">
// Classify each sample result into error categories
def label = prev.getSampleLabel()
def responseCode = prev.getResponseCode()
def responseMessage = prev.getResponseMessage() ?: ""
def success = prev.isSuccessful()

if (!success) {
    // Classify the error type
    if (responseCode == "Websocket I/O error" || responseMessage.contains("Connect timed out") || responseMessage.contains("Connection refused")) {
        // Infrastructure error: connection failure
        def count = (props.get("INFRA_ERRORS") ?: "0").toInteger() + 1
        props.put("INFRA_ERRORS", count.toString())
    } else if (responseMessage.contains("Assertion") || prev.getAssertionResults()?.length > 0) {
        // Assertion mismatch: response received but didn't match expected pattern
        def count = (props.get("ASSERTION_MISMATCHES") ?: "0").toInteger() + 1
        props.put("ASSERTION_MISMATCHES", count.toString())
    } else if (responseCode == "Sampler error") {
        // Sampler configuration/protocol error
        def count = (props.get("SAMPLER_ERRORS") ?: "0").toInteger() + 1
        props.put("SAMPLER_ERRORS", count.toString())
    } else {
        // Application error (server returned error response)
        def count = (props.get("APP_ERRORS") ?: "0").toInteger() + 1
        props.put("APP_ERRORS", count.toString())
    }
}

// Track total samples for error rate calculation
def total = (props.get("TOTAL_SAMPLES") ?: "0").toInteger() + 1
props.put("TOTAL_SAMPLES", total.toString())

// Auto-stop: check infrastructure error rate every 100 samples
if (total % 100 == 0) {
    def infraErrors = (props.get("INFRA_ERRORS") ?: "0").toInteger()
    def threshold = (vars.get("ERROR_THRESHOLD_PCT") ?: "25").toInteger()
    def errorPct = (infraErrors * 100.0) / total
    if (errorPct > threshold &amp;&amp; total > 200) {
        log.error("AUTO-STOP: Infrastructure error rate ${errorPct.round(1)}% exceeds threshold ${threshold}%. Stopping test.")
        ctx.getEngine().stopTest(false)  // graceful stop
    }
}
        </stringProp>
      </JSR223Listener>
      <hashTree/>

      <!-- ================================================================ -->
      <!-- LISTENERS                                                        -->
      <!-- ================================================================ -->

      <!-- Summary Report -->
      <ResultCollector guiclass="SummaryReport" testclass="ResultCollector" testname="Summary Report" enabled="true">
        <boolProp name="ResultCollector.error_logging">false</boolProp>
        <objProp>
